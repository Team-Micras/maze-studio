{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "vendor/**", ".omc/**"],
  "rules": {
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expect*"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true,
        "allowExportNames": ["buttonVariants", "badgeVariants", "toggleVariants"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["sw/**"],
      "rules": {
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": [
        "tests/e2e/**",
        "tests/support/library/browser-deflate.ts",
        "tests/support/ui/frames.ts",
        "tests/support/ui/touch.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/**", "tests/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts|vendor))(/|$)",
                "message": "Shipped code never imports tests, scripts or the vendored repositories."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui draws with React; keep this folder framework free."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/maze/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts|vendor))(/|$)",
                "message": "Shipped code never imports tests, scripts or the vendored repositories."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui draws with React; keep this folder framework free."
              },
              {
                "regex": "^@/",
                "message": "src/maze imports nothing else in maze-studio; import other maze modules by relative path."
              },
              {
                "regex": "^(\\.\\./)+(library|render|ui|main)(/|$)",
                "message": "src/maze imports nothing else in maze-studio; import other maze modules by relative path."
              },
              {
                "regex": "^node:",
                "message": "src/maze runs in the browser and in Node alike; it never imports Node's modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/library/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts|vendor))(/|$)",
                "message": "Shipped code never imports tests, scripts or the vendored repositories."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui draws with React; keep this folder framework free."
              },
              {
                "regex": "^(@/(library|render|ui|main)|(\\.\\./)+(render|ui|main))(/|$)",
                "message": "src/library depends only on src/maze; reach its own files by relative path."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/render/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts|vendor))(/|$)",
                "message": "Shipped code never imports tests, scripts or the vendored repositories."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Only src/ui draws with React; keep this folder framework free."
              },
              {
                "regex": "^(@/(library|render|ui|main)|(\\.\\./)+(library|ui|main))(/|$)",
                "message": "src/render depends only on src/maze; reach its own files by relative path."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts|vendor))(/|$)",
                "message": "Shipped code never imports tests, scripts or the vendored repositories."
              },
              {
                "regex": "^(@/main|(\\.\\./)+main)(/|$)",
                "message": "The UI never imports the entry point; src/main.tsx wires the app together."
              },
              {
                "regex": "^@phosphor-icons/react/",
                "message": "Import Phosphor icons by name from @phosphor-icons/react itself, never from its inner paths."
              },
              {
                "group": ["@phosphor-icons/react"],
                "allowImportNamePattern": "^[A-Z][A-Za-z0-9]*$",
                "message": "Import Phosphor icons by name, so only the icons used are bundled."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^((@tests|@scripts)|(\\.\\./)+(tests|scripts|vendor))(/|$)",
                "message": "Shipped code never imports tests, scripts or the vendored repositories."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/**",
        "*.config.ts",
        "tests/e2e/**",
        "tests/config/**",
        "tests/support/library/browser-deflate.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@tests|(\\.\\./)+tests)(/|$)",
                "message": "Scripts never import tests."
              },
              {
                "regex": "^(@/(render|ui|main)|(\\.\\./)+src/(render|ui|main))(/|$)",
                "message": "Scripts may only depend on src/maze and src/library."
              },
              {
                "regex": "^react(-dom)?(/.*)?$",
                "message": "Tools are Node scripts; no React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/library/mine.ts"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["src/render/thumbnails.ts"],
      "rules": {
        "unicorn/no-array-fill-with-reference-type": "off"
      }
    },
    {
      "files": ["src/ui/board/camera-stage.tsx"],
      "rules": {
        "jsx-a11y/no-noninteractive-tabindex": ["error", { "roles": ["application"] }],
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    }
  ]
}
